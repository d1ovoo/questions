# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# publishable key (sb_publishable_...) or the legacy anon key; safe in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key (sb_secret_...) or the legacy service_role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Generator (local only; not needed on Vercel) -------------------------
# LLM_PROVIDER=ollama            # ollama (default) or openai (any OpenAI-compatible API)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# LLM_VERIFY_MODEL=              # optional different model for the verification pass

# Free API tier instead of Ollama, e.g. Groq:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama-3.3-70b-versatile
# LLM_DELAY_MS=2000              # pause between calls to stay under rate limits
# Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  OPENAI_MODEL=gemini-2.0-flash

# GEN_MIN_DAILY_VIEWS=150        # average Wikipedia views/day over 30 days
# GEN_MIN_ARTICLE_BYTES=6000     # skip stubs
# GEN_MIN_EXTRACT_CHARS=1500
# GEN_MAX_EXTRACT_CHARS=6000
# GEN_SIMILARITY_THRESHOLD=0.85  # cosine similarity above this = duplicate
# GEN_USER_AGENT=questions-generator/1.0 (you@example.com)   # Wikimedia asks for a contact
